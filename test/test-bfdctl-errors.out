
======= NO  OP / NO MON =======

---- ../bfdctl -C bfdd.sock

you must specify an operation

---- ../bfdctl -C bfdd.sock -m

you must specify an operation

---- ../bfdctl -C bfdd.sock -m -p 127.0.0.2

you must specify an operation

---- ../bfdctl -C bfdd.sock -p 127.0.0.2

you must specify an operation

======= NO  OP /    MON =======

---- ../bfdctl -C bfdd.sock -M

Response:
{
  "status":"ok"
}

---- ../bfdctl -C bfdd.sock -M -m

Response:
{
  "status":"ok"
}

---- ../bfdctl -C bfdd.sock -M -m -p 127.0.0.2

Response:
{
  "status":"error",
  "error":"failed to parse notify data"
}

---- ../bfdctl -C bfdd.sock -M -p 127.0.0.2

Response:
{
  "status":"error",
  "error":"failed to parse notify data"
}

======= ADD OP /    MON =======

---- ../bfdctl -C bfdd.sock -M -a

you must specify a remote peer

---- ../bfdctl -C bfdd.sock -M -a -m

you must specify a remote peer

---- ../bfdctl -C bfdd.sock -M -a -m -p 127.0.0.2

Response:
{
  "status":"error",
  "error":"request add failed"
}
Response:
{
  "status":"error",
  "error":"failed to parse notify data"
}

